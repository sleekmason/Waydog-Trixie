#!/bin/bash
# Made by sleekmason 30 nov 2025
# waypaper-sddm — Select sddm background

CONFIG_FILE="$HOME/.config/waypaper/config.ini"
STATE_FILE="$HOME/.config/waypaper/sddm/config.ini"
SDDM_BG="/usr/share/sddm/themes/fane/background.jpg"
SCRIPT_PATH="$(readlink -f "$0")"

get_real_wallpaper() {
    local result=""
    if command -v jq >/dev/null 2>&1; then
        result=$(waypaper --list 2>/dev/null | jq -r '(map(select(.monitor=="All")) + .)[0].wallpaper // empty' 2>/dev/null)
    fi
    if [[ -z "$result" ]]; then
        result=$(grep -E '^wallpaper *= *' "$CONFIG_FILE" 2>/dev/null | cut -d= -f2- | xargs)
    fi
    printf '%s' "$result"
}

if [[ "$1" == "--post" ]]; then
    selected_wallpaper="$2"
    real_wallpaper=""
    if [[ -n "$WAYPAPER_SDDM_REAL_WALLPAPER_FILE" && -f "$WAYPAPER_SDDM_REAL_WALLPAPER_FILE" ]]; then
        real_wallpaper="$(cat "$WAYPAPER_SDDM_REAL_WALLPAPER_FILE" 2>/dev/null)"
    fi

    (
        if [[ -f "$selected_wallpaper" ]]; then
            pkexec cp -f "$selected_wallpaper" "$SDDM_BG"
            if [[ $? -eq 0 ]]; then
                NOTIFY_NAME=$(basename "$selected_wallpaper")
                notify-send -i dialog-information --urgency low "SDDM Background changed to: $NOTIFY_NAME"
            fi
        fi

        if [[ -n "$real_wallpaper" && -f "$real_wallpaper" ]]; then
            (
                flock -w 5 200 || exit 0
                pkill -x swaybg 2>/dev/null
                swaybg -m fill -i "$real_wallpaper" >/dev/null 2>&1 200>&- &
                disown
            ) 200>/tmp/waypaper-sddm-swaybg.lock
        fi

        WF_SHELL_CONFIG="$HOME/.config/wf-shell.ini"
        if [[ -f "$WF_SHELL_CONFIG" && -n "$real_wallpaper" ]]; then
            sed -i "s|^image *=.*|image=$real_wallpaper|" "$WF_SHELL_CONFIG" 2>/dev/null
        fi
    ) & disown

    exit 0
fi

if ! command -v sddm >/dev/null 2>&1; then
    notify-send -i preferences-system -u low "Please install SDDM to use this feature."
    exit 0
fi

mkdir -p "$(dirname "$STATE_FILE")"

if [[ ! -f "$STATE_FILE" ]]; then
    cp "$CONFIG_FILE" "$STATE_FILE"
fi

sed -i "s|^post_command[[:space:]]*=.*|post_command = \"$SCRIPT_PATH\" --post \"\$wallpaper\"|" "$STATE_FILE"

if ! grep -qE '^post_command[[:space:]]*=' "$STATE_FILE"; then
    sed -i "/^\[Settings\]/a post_command = \"$SCRIPT_PATH\" --post \"\$wallpaper\"" "$STATE_FILE"
fi

REAL_WALLPAPER_FILE="$(mktemp /tmp/waypaper-sddm-real-XXXXXX)"
export WAYPAPER_SDDM_REAL_WALLPAPER_FILE="$REAL_WALLPAPER_FILE"
(
    result="$(get_real_wallpaper)"
    result="${result/#\~/$HOME}"
    printf '%s' "$result" > "$REAL_WALLPAPER_FILE"
) &
LOOKUP_PID=$!

waypaper --config-file "$STATE_FILE" --state-file "$STATE_FILE" >/dev/null 2>&1

wait "$LOOKUP_PID" 2>/dev/null
rm -f "$REAL_WALLPAPER_FILE"

exit 0
