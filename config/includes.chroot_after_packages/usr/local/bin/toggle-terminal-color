ozark(){
    xfconf-query -c xfce4-terminal -p /color-background -s "#28282d2c3333"
    xfconf-query -c xfce4-terminal -p /color-foreground -s "#dbdbdbdbd9d9"
    xfconf-query -c xfce4-terminal -p /color-palette -s "rgb(24,27,31);rgb(242,77,77);rgb(40,173,111);rgb(235,216,174);rgb(136,202,235);rgb(239,139,192);rgb(50,187,178);rgb(166,172,174);rgb(137,146,153);rgb(231,91,91);rgb(71,207,133);rgb(245,230,196);rgb(132,207,245);rgb(255,156,212);rgb(65,232,204);rgb(209,212,215)"
    sed -i 's/^background =.*/background = #282D33/g' "$HOME/.config/ghostty/config.ghostty"
  if command -v "alacritty" >/dev/null 2>&1; then
      if ! [[ -f "$HOME/.config/alacritty/alacritty.toml" ]]; then
          cp -fr "/etc/xdg/alacritty" "$HOME/.config"
      fi
      sed -i '0,/^background =.*/s//background = "#282D33"/' "$HOME/.config/alacritty/alacritty.toml"
  fi
  
  if command -v "foot" >/dev/null 2>&1; then
      if ! [[ -f "$HOME/.config/foot/foot.ini" ]]; then
          cp -fr "/etc/xdg/foot" "$HOME/.config"
      fi
      sed -i 's/^background=.*/background=#282D33/g' "$HOME/.config/foot/foot.ini"
  fi
  notify-send -i utilities-system-monitor "Terminal color ▸ Gray"
}

export -f fane
export -f ink
export -f drow
export -f raz
export -f ozark

yad --title "Terminal Color" --escape-ok --borders=14 \
--width=220 --height=280 \
--button="Mako Sync:mako-colorsync" \
--button="gtk-ok:0" \
    --form --columns=1 \
    --field="Blue":FBTN "bash -c fane" \
    --field="Black":FBTN "bash -c ink" \
    --field="Brown":FBTN "bash -c drow" \
    --field="Purple":FBTN "bash -c raz" \
    --field="Gray":FBTN "bash -c ozark"
