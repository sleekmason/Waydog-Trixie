    xfconf-query -c xfce4-terminal -p /color-foreground -s "#d9d9d9d9d7d7"
    sed -i 's/^background =.*/background = #18191a/g' "$HOME/.config/ghostty/config.ghostty"
  if command -v "alacritty" >/dev/null 2>&1; then
      if ! [[ -f "$HOME/.config/alacritty/alacritty.toml" ]]; then
          cp -fr "/etc/xdg/alacritty" "$HOME/.config"
      fi
      sed -i '0,/^background =.*/s//background = "#18191a"/' "$HOME/.config/alacritty/alacritty.toml"
  fi     
  if command -v "foot" >/dev/null 2>&1; then
      if ! [[ -f "$HOME/.config/foot/foot.ini" ]]; then
          cp -fr "/etc/xdg/foot" "$HOME/.config"
      fi
      sed -i 's/^background=.*/background=18191a/g' "$HOME/.config/foot/foot.ini"
  fi
  notify-send -i utilities-system-monitor "Terminal color  ▸ Dark Brown" "(Dragon theme)"
}

