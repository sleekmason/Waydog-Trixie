#!/bin/bash
# zswap toggle - Adds a systemd service that enables zswap with zstd.
# Based on https://gist.github.com/alex-rusakevich/da8bb5e875187a2f3f7046aa1677c8a7
# Made by sleekmason 09 Aug 2026

GKSUDO="/usr/local/bin/gksudo"
SCRIPT_DST="/usr/local/bin/zswap-systemd"
SERVICE_DST="/etc/systemd/system/zswap-systemd.service"

zswap_installed=false
[ -f "$SERVICE_DST" ] && zswap_installed=true
RESULT=$(
yad \
    --title="Zswap Toggle" \
    --window-icon=drive-harddisk \
    --width=640 \
    --height=200 \
    --borders=12 \
    --center \
    --image=preferences-desktop \
    --text="          <b>Enable zswap with zstd compression via systemd (survives reboot)</b>" \
    --list \
    --checklist \
    --separator="|" \
    --column="Select:CHK" \
    --column="Function" \
    --column="Description" \
    "$zswap_installed" \
        "Zswap (zstd/zsmalloc)" \
        "Enable zswap with zstd compression" \
    --button="Enable!gtk-ok:0" \
    --button="Flush Cache!view-refresh:3" \
    --button="Disable!gtk-delete:2" \
    --button="Close!gtk-close:1"
)
RET=$?
zswap_checked=false
while IFS='|' read -r chk name desc; do
    case "$name" in
        "Zswap (zstd/zsmalloc)")
            [ "$chk" = "TRUE" ] && zswap_checked=true
            ;;
    esac
done <<< "$RESULT"
case "$RET" in
0)
    if $zswap_checked && $zswap_installed; then
        notify-send -i info -u low "Zswap already enabled"
    elif $zswap_checked; then
        CMDS="set -e; "
        CMDS+="printf '%s\n' \
'#!/bin/bash' \
'' \
'# Enable zswap with preferred parameters' \
'enable_zswap() {' \
'    echo 1 > /sys/module/zswap/parameters/enabled' \
'    echo zstd > /sys/module/zswap/parameters/compressor' \
'    if [ -e /sys/module/zswap/parameters/zpool ]; then' \
'        echo zsmalloc > /sys/module/zswap/parameters/zpool' \
'    fi' \
'    echo 20 > /sys/module/zswap/parameters/max_pool_percent' \
'    echo \"zswap enabled with zstd compressor and zsmalloc zpool\"' \
'}' \
'' \
'case \"\$1\" in' \
'    start)' \
'        enable_zswap' \
'        ;;' \
'    stop)' \
'        echo 0 > /sys/module/zswap/parameters/enabled' \
'        ;;' \
'    *)' \
'        echo \"Usage: \$0 {start|stop}\"' \
'        exit 1' \
'        ;;' \
'esac' \
'' \
'exit 0' \
> '$SCRIPT_DST'; chmod 755 '$SCRIPT_DST'; "
        CMDS+="printf '%s\n' \
'[Unit]' \
'Description=Zswap Management Service' \
'After=local-fs.target zstd.service' \
'' \
'[Service]' \
'Type=oneshot' \
'RemainAfterExit=yes' \
'ExecStart=$SCRIPT_DST start' \
'ExecStop=$SCRIPT_DST stop' \
'' \
'[Install]' \
'WantedBy=multi-user.target' \
> '$SERVICE_DST'; chmod 644 '$SERVICE_DST'; "
        CMDS+="systemctl daemon-reload; systemctl enable zswap-systemd.service; systemctl start zswap-systemd.service"
        if $GKSUDO /bin/bash -c "$CMDS"; then
            notify-send -i info -u low "Zswap enabled"
        else
            notify-send -i info "Unable to apply zswap"
        fi
    fi
    ;;
2)
    CMDS="set -e; "
    if $zswap_checked; then
        CMDS+="systemctl stop zswap-systemd.service || true; systemctl disable zswap-systemd.service || true; "
        CMDS+="rm -f '$SCRIPT_DST' '$SERVICE_DST'; "
        CMDS+="systemctl daemon-reload"
        if $GKSUDO /bin/bash -c "$CMDS"; then
            notify-send -i info -u low "Zswap disabled"
        else
            notify-send -i info "Unable to remove zswap"
        fi
    fi
    ;;
3)
    if yad --title="Flush Zswap Cache" --width=500 --center --borders=10 \
    --text="<b>This will run 'swapoff -a', then 'swapon -a' to force all cached pages back into RAM and reload swap.</b>\n\nNote that this can hang or fail if there isn't enough free RAM to hold everything currently in swap...  <b>Continue?</b>" \
    --button="gtk-cancel:1" --button="gtk-yes:0"; then
        CMDS="set -e; swapoff -a; swapon -a"
        if $GKSUDO /bin/bash -c "$CMDS"; then
            notify-send -i info -u low "Zswap cache flushed"
        else
            notify-send -i info "Unable to flush cache"
        fi
    fi
    ;;
*)
    exit 0
    ;;
esac
exit 0
