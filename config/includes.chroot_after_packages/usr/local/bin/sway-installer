#!/bin/bash
read -p "   [0;33mSway Compositor Installer[0m

   Sway comes pre-installed on Waydog, but if needing to reinstall
   or refresh the Sway config, this is the installer to use. A new
   ~/.config/sway.bak will be created if the config is present, or
   a new Sway configuration will be added to ~/.config if needed.
   
   If Sway currently shows at login and you want to hide the login
   entry and also move the config to sway.bak, in a terminal type:
   [0;32mdisable-sway[0m
   
   This will keep Sway(330kb) installed, as it's also a dependency
   for some of the other packages used in Waydog. Don't uninstall.
   
   [0;32m----------------------------------------------------------------

   Please press enter to enable or refresh the Sway Compositor.

   ----------------------------------------------------------------[0m

   Or, close this terminal window to quit the install." ;

if : >/dev/tcp/8.8.8.8/53; then

cd /tmp || exit

rm -f /tmp/sway-config.zip
rm -fr /tmp/sway-config

wget --prefer-family=IPv4 https://raw.githubusercontent.com/sleekmason/packages/master/sway-config.zip --show-progress -q || exit
unzip -q "/tmp/sway-config.zip"

sudo apt update
sudo apt install -y sway

if [ -e "$HOME/.config/sway" ]; then
   rm -rf "$HOME/.config/sway.bak"
   mv "$HOME/.config/sway" "$HOME/.config/sway.bak"
fi
cp -fr "/tmp/sway-config/sway" "$HOME/.config"

LAYOUT=$(grep '^XKBLAYOUT=' /etc/default/keyboard | cut -d'"' -f2)
[[ -z "$LAYOUT" ]] && LAYOUT="us"
sed -i "s|xkb_layout \"[^\"]*\"|xkb_layout \"$LAYOUT\"|" "$HOME/.config/sway/config"

FILE_SWAY=/usr/share/wayland-sessions/sway.desktop
if [ -f "$FILE_SWAY" ]; then
    sudo sed -i '/NoDisplay=true/d' "$FILE_SWAY"
fi

FILE_WAYBAR=$HOME/.config/waybar/sway
if ! [ -f "$FILE_WAYBAR" ]; then
mkdir -p "$FILE_WAYBAR"
cp -f "/tmp/sway-config/config.jsonc" "$FILE_WAYBAR"
if [[ "$(systemctl is-enabled power-profiles-daemon 2>/dev/null)" == "masked" ]]; then
    sed -Ei \
        's/^([[:space:]]*)"power-profiles-daemon"(,?)[[:space:]]*$/\1\/\/ "power-profiles-daemon"\2/' \
        "$HOME/.config/waybar/sway/config.jsonc"
else
    sed -Ei \
        's/^([[:space:]]*)\/\/[[:space:]]*"power-profiles-daemon"(,?)[[:space:]]*$/\1"power-profiles-daemon"\2/' \
        "$HOME/.config/waybar/sway/config.jsonc"
fi
fi

echo "   [0;32m--------------------------------------------------------[0m"
echo ""
echo "   [0;33mAll Finished![0m"
echo ""
echo "   [0;32mYou should now see a new login entry for Sway.[0m"
echo ""
echo "   [0;32m--------------------------------------------------------[0m"
echo ""
else
echo ""
 echo "   [0;31m-----------------------------------------------------[0m"
 echo ""
 echo "   [0;33mNo Internet connection. Please connect and try again.[0m"
 echo ""
 echo "   [0;31m-----------------------------------------------------[0m"
echo ""
fi
read -n1 -p " Press any key to quit this dialog ... "
