#!/bin/bash
# labwc menu alpha toggle
# Toggles transparency on and off in conjunction with menu-alpha-sync.
# Made by sleekmason 17 Oct 2026

cfg="${XDG_CONFIG_HOME:-$HOME/.config}/labwc"
ovr="$cfg/themerc-override"
auto="$cfg/autostart"
sync_cmd="menu-alpha-sync"

key_re='menu\.items\.bg\.color:'
min_pct=0
auto_re="^[[:space:]]*#?[[:space:]]*([^[:space:]#]*\/)?$sync_cmd([[:space:]]|&|\$)"

mkdir -p "$cfg"
touch "$ovr" "$auto"

if grep -q "^[[:space:]]*$key_re" "$ovr"; then
    state=TRUE
else
    state=FALSE
fi

cur_hex=$(sed -n -E "s/^[[:space:]]*#?[[:space:]]*$key_re[[:space:]]*#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2}).*/\1/p" "$ovr" | tail -n1)
cur_hex="${cur_hex:-E5}"
pct=$(( (16#$cur_hex * 100 + 127) / 255 ))

dialog=$(yad --form --center --width=320 --height=146 --borders=8 \
    --title="Menu Transparency" \
    --window-icon=preferences-desktop-theme \
    --field=" Menu Transparency On/Off:CHK" "$state" \
    --field=" Opacity (%)                     :NUM" "$pct!$min_pct..100!1" \
    --button="Close!gtk-cancel:1" \
    --button="Apply!gtk-ok:0") || exit 0

IFS='|' read -r new_state new_pct _ <<< "$dialog"
new_pct="${new_pct%%[.,]*}"
[[ "$new_pct" =~ ^[0-9]+$ ]] || new_pct=$pct
hex=$(printf '%02X' $(( new_pct * 255 / 100 )))

stop_sync() {
    local p
    for p in $(pgrep -f "(^|/)$sync_cmd\$"); do
        pkill -P "$p" 2>/dev/null
        kill "$p" 2>/dev/null
    done
}

start_sync() {
    local exe
    exe=$(command -v "$sync_cmd") || exe="$(dirname "$(readlink -f "$0")")/$sync_cmd"
    if [ ! -x "$exe" ]; then
        notify-send -u critical -i important "Menu transparency" "$sync_cmd not found"
        return 1
    fi

    "$exe" --once

    pgrep -f "(^|/)$sync_cmd\$" >/dev/null && return
    setsid -f "$exe" >/dev/null 2>&1
}

append_line() {
    [ -s "$1" ] && [ -n "$(tail -c1 "$1")" ] && echo >> "$1"
    printf '%s\n' "$2" >> "$1"
}

reconfigure() {
    [ -n "$LABWC_PID" ] && labwc --reconfigure
}

if ! grep -q "^[[:space:]]*#\?[[:space:]]*$key_re" "$ovr"; then
    append_line "$ovr" "#menu.items.bg.color: #000000$hex"
fi

sed -i -E "s/^([[:space:]]*#?[[:space:]]*$key_re[[:space:]]*#[0-9A-Fa-f]{6})[0-9A-Fa-f]*/\1$hex/" "$ovr"

if [ "$new_state" = TRUE ]; then
    sed -i -E "s/^([[:space:]]*)#[[:space:]]*($key_re)/\1\2/" "$ovr"
    sed -i -E "/$auto_re/d" "$auto"
    append_line "$auto" "$sync_cmd &"

    start_sync
    reconfigure
    notify-send -u low -i computer "Menu transparency  ▸  ${new_pct}%"
else
    sed -i -E "/^[[:space:]]*#/! s/^([[:space:]]*)($key_re)/\1#\2/" "$ovr"
    sed -i -E "/$auto_re/d" "$auto"
    stop_sync
    reconfigure
    notify-send -u low -i computer "Menu transparency off"
fi
exec "$(readlink -f "$0")"
