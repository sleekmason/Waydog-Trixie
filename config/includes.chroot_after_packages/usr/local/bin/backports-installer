#!/bin/bash
read -p "   
                         [0;32mAdd Backports Sources[0m
  
   This script adds the Trixie Backports sources to your repository.
   
   Afterwards, append the package to install through backports with:
   '/trixie-backports'. For example, to install ncat from backports:
   
   [0;34msudo apt install ncat/trixie-backports[0m  
   
   [0;31mhttps://backports.debian.org/Instructions/[0m
      
   [0;32m-----------------------------------------------------------------
   
   Please press Enter to add Trixie Backports.
   
   -----------------------------------------------------------------[0m


   Or, close this terminal window to quit." ;
   if : >/dev/tcp/8.8.8.8/53; then
echo ""
   echo ""
   echo ""
sudo cp -f "/usr/share/lilidog/extras/backports/trixie-backports.sources" "/etc/apt/sources.list.d" &&  
   sudo apt update
   echo ""
   echo "[0;32m---------------------------------------"
   echo ""
   echo "Trixie backports enabled and updated."
   echo ""
   echo "---------------------------------------[0m"
   echo ""
else
echo ""
 echo "   [0;31m-----------------------------------------------------[0m"
 echo ""
 echo "   [0;33mNo Internet connection. Please connect and try again.[0m"
 echo ""
 echo "   [0;31m-----------------------------------------------------[0m"
echo ""
fi
read -n1 -p " Press any key to quit this dialog ... "
