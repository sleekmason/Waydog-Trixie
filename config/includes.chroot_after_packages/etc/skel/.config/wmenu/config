# Main options for wmenu.
# Man wmenu for all options.
# Wmenu in Waydog is started from /usr/local/bin/wdmenu

WMENU_OPTS=(
  -f "Cantarell 10"
  -p 'Type to search:' 
  -i

# wmenu on bottom  
#  -b

# Colors background
  -M 11191f               # prompt bg
  -N 121314ff             # main bg
  -S 2D5170               # selection bg

# Colors foreground
  -m D1D1D1               # prompt fg
  -n D1D1D1               # main fg
  -s FFFFFF               # selection fg 
)
